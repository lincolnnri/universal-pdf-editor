# Copie para .env e ajuste conforme necessário.
UPE_MAX_UPLOAD_MB=50            # tamanho máximo do PDF
UPE_MAX_PAGES=300               # número máximo de páginas
UPE_MAX_IMAGE_MB=10             # tamanho máximo de imagens adicionadas
UPE_SESSION_TTL_MINUTES=60      # arquivos são apagados após esse tempo sem uso
# UPE_WORK_DIR=/tmp/universal-pdf-editor   # diretório temporário isolado
UPE_OCR_LANGS=por+eng           # idiomas do Tesseract
UPE_OCR_DPI=300
UPE_OCR_TIMEOUT_S=120
# UPE_TESSDATA_DIR=             # padrão: backend/tessdata (já inclui por e eng)
UPE_VERIFY_OUTSIDE_TOLERANCE=0.002   # fração de pixels que pode mudar fora das áreas editadas
UPE_CORS_ORIGINS=http://localhost:5173
